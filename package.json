{
  "name": "@local/philosophy-terms",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "A philosophy reading lexicon: three SEP-grounded terms per book, reader ratings, clickable concept chains, a book library, and a rerollable daily term.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Huayuu-z/dsh-philosophy-terms.git"
  },
  "homepage": "https://github.com/Huayuu-z/dsh-philosophy-terms",
  "bugs": {
    "url": "https://github.com/Huayuu-z/dsh-philosophy-terms/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "philosophy",
    "stanford-encyclopedia-of-philosophy",
    "sep",
    "reading"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
